# FamilyShop — à déposer à la racine du sous-domaine, renommé .htaccess

# Le code de l'application : sans lui, les droits seraient lus pour
# « portail » et non pour « familyshop ».
SetEnv NHA_APP familyshop

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RedirectMatch 404 ^/config/

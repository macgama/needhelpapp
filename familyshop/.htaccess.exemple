# FamilyShop — à déposer à la racine du sous-domaine, renommé .htaccess

# Le code de l'application : sans lui, les droits seraient lus pour
# « portail » et non pour « familyshop ».
SetEnv NHA_APP familyshop

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RedirectMatch 404 ^/config/

# ---- En-têtes de sécurité ----
#
# Ce bloc manquait ici alors qu'il existait sur le portail et sur budget.
# Ce n'est pas un détail de confort : le cookie anti-CSRF du portail est
# posé sur .needhelpapp.com, donc une faille d'injection sur CE
# sous-domaine permettrait d'y écrire un jeton choisi et de forger une
# requête vers needhelpapp.com. Les sous-domaines se tiennent les uns les
# autres — celui qui est le moins protégé décide du niveau de tous.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Identique à celle du portail : familyshop ne charge rien de l'extérieur
  # hormis le bouton de connexion Google. Les illustrations de recettes
  # vivent dans assets/recettes/, donc en 'self'.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.googleusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://accounts.google.com/gsi/client; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; font-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ---- Fichiers jamais servis ----
<FilesMatch "(^\.|\.(sql|md|log|ini)$)">
  Require all denied
</FilesMatch>

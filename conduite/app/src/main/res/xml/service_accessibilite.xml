<?xml version="1.0" encoding="utf-8"?>
<!--
  On ne demande QUE le changement de fenêtre, et on ne réclame ni le
  contenu des écrans, ni la possibilité d'agir dessus.

  `canRetrieveWindowContent` reste à false : le service n'a besoin que du
  nom du paquet affiché, jamais de ce qui s'y trouve. Le déclarer à true
  « au cas où » donnerait accès à tout ce que l'utilisateur lit et tape,
  y compris ses mots de passe. Cette ligne est la différence entre un
  outil et un mouchard.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibilite_description"
    android:notificationTimeout="100" />
